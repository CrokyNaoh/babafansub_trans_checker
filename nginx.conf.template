server {
    listen 80;
    server_name __NGINX_SERVER_NAME__ localhost;
    
    # 前端静态文件根目录
    root __FRONTEND_ROOT__;
    
    # 后端 API 代理
    location ^~ /transtool-py/api/ {
        proxy_pass http://127.0.0.1:5000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 增加超时时间（处理大文件）
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        
        # 允许大文件上传（文件上限 10MB，上传时表单编码另有少量开销，留 1M 余量）
        client_max_body_size 11M;
    }

    # ===== 管理页与管理接口：需要账号密码（D1） =====
    # 账号用 sudo deploy/admin_password.sh 管理，见 TUTORIAL.md「管理页密码」
    location = /transtool-py/croky.html {
        auth_basic "transtool admin";
        auth_basic_user_file /etc/nginx/transtool-py.htpasswd;
        alias __FRONTEND_ROOT__/croky.html;
        add_header Cache-Control "no-cache";
    }

    location = /transtool-py/api/projects {
        auth_basic "transtool admin";
        auth_basic_user_file /etc/nginx/transtool-py.htpasswd;
        proxy_pass http://127.0.0.1:5000/api/projects;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /transtool-py/api/reload-config {
        auth_basic "transtool admin";
        auth_basic_user_file /etc/nginx/transtool-py.htpasswd;
        proxy_pass http://127.0.0.1:5000/api/reload-config;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 检查页不缓存，部署后组员刷新即可看到新版（css/js 链接带版本号）
    location = /transtool-py/index.html {
        alias __FRONTEND_ROOT__/index.html;
        add_header Cache-Control "no-cache";
    }
    
    # 静态资源
    location /transtool-py/ {
        alias __FRONTEND_ROOT__/;
        try_files $uri $uri/ =404;
        # 静态资源缓存
        add_header Cache-Control "public, max-age=86400";
    }
    
    # 日志
    access_log /var/log/nginx/transtool_py_access.log;
    error_log /var/log/nginx/transtool_py_error.log;
}
